# =====================================================================
# Variables de Nodus en producción.
# Cópialo como `.env` en el servidor (cp .env.production.example .env) y llena cada valor.
# NUNCA subas el archivo `.env` a git ni lo compartas por chat o correo.
# =====================================================================

# ---------- Dominio ----------
# El dominio sin https:// (ej. app.nodusbc.mx). Caddy saca su certificado HTTPS solo.
DOMINIO=
# La dirección completa con https://, sin diagonal al final. Sirve para que el banco
# regrese al cliente a Nodus después de la verificación 3D Secure.
NEXT_PUBLIC_SITE_URL=

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave "service_role": es SECRETA, da acceso total a la base. Solo vive en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Tareas programadas ----------
# Cualquier texto largo y aleatorio (ej. el resultado de: openssl rand -hex 32).
CRON_SECRET=

# ---------- Correo (Resend) ----------
RESEND_API_KEY=
# El dominio del remitente debe estar verificado en Resend (SPF y DKIM).
EMAIL_FROM=Nodus Flex Center <notificaciones@nodusbc.mx>

# ---------- Openpay (PRODUCCIÓN) ----------
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
# Sandbox: https://sandbox-api.openpay.mx/v1  ·  Producción: https://api.openpay.mx/v1
OPENPAY_API_URL=https://api.openpay.mx/v1
NEXT_PUBLIC_OPENPAY_MERCHANT_ID=
NEXT_PUBLIC_OPENPAY_PUBLIC_KEY=
# false en producción (true solo con llaves de pruebas).
NEXT_PUBLIC_OPENPAY_SANDBOX=false

# ---------- UniFi (WiFi de Bosques) ----------
# El servidor en la nube NO ve la red de la oficina: usa una VPN (ver DESPLIEGUE.md,
# "UniFi") y pon aquí la dirección por la que se llega al controlador. Si todavía no está
# resuelto, déjalo como está: la generación de vouchers reales fallará y se registrará el error.
UNIFI_BOSQUES_HOST=
UNIFI_BOSQUES_PORT=443
UNIFI_BOSQUES_USERNAME=
UNIFI_BOSQUES_PASSWORD=
UNIFI_BOSQUES_SITE=default
